# ============================================================================
# Foundry
# ============================================================================
cache/
out/

# Broadcast logs (keep non-local deployments)
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/
TECHNICAL_OVERVIEW.md

# ============================================================================
# ZK Artifacts
# ============================================================================
# Ignore build intermediates
circuits/build/*.r1cs
circuits/build/*.sym
circuits/build/*.wcd
circuits/build/*.wtns
circuits/build/*_0000.zkey
circuits/build/*.json
circuits/build/*.sol
circuits/build/*.wasm
circuits/build/generate_witness.js
circuits/build/witness_calculator.js

# Ignore ptau files (large, downloaded)
circuits/build/ptau_files/
*.ptau

# Test proofs (regenerated)
circuits/test_proofs/

# Test inputs (generated at runtime)
circuits/test_inputs/custom_case.json
circuits/helpers/identity_input_*.json

# ============================================================================
# IMPORTANT: Track these artifacts for reproducible builds
# ============================================================================
# Final zkey (contains verification key)
!circuits/build/*_final.zkey

# Verification key JSON
!circuits/build/*_verification_key.json

# WASM and witness generator
!circuits/build/*_js/

# ============================================================================
# Dependencies
# ============================================================================
node_modules/
lib/

# Playground dependencies
playground/node_modules/
playground/package-lock.json

# ============================================================================
# Environment
# ============================================================================
.env
.env.*
!.env.example
.claude/

# ============================================================================
# IDE
# ============================================================================
.vscode/
.idea/
*.swp
*.swo

# ============================================================================
# OS
# ============================================================================
.DS_Store
Thumbs.db

# ============================================================================
# Docker (don't track overrides)
# ============================================================================
docker-compose.override.yml
